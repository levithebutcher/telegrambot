# ==============================================================================
# Telegram Media & Bypass Bot Configuration (.env)
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file or credentials to version control!
# ==============================================================================

# [REQUIRED] Telegram Bot Token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# [ADMIN] Telegram User ID of the bot owner/admin (prevents unauthorized /setadmin claims)
ADMIN_ID=123456789

# [OPTIONAL] Telethon MTProto Client Credentials (enables uploads up to 2 GB)
# Get these from https://my.telegram.org -> API development tools
API_ID=
API_HASH=

# [OPTIONAL] Max file size in MB (defaults to 2000 MB if Telethon is configured, else 50 MB)
MAX_FILE_SIZE_MB=2000

# [OPTIONAL] Download directory for temporary processing
DOWNLOAD_DIR=downloads

# [OPTIONAL] Forced subscription channel username or ID (e.g., @mychannel or -100xxxxxxxxxx)
FORCE_SUB_CHANNEL=

# [OPTIONAL] Deployment & Keep-Alive (for hosting platforms like Render, Koyeb)
PORT=8080
RENDER_EXTERNAL_URL=

# [OPTIONAL] FFmpeg binary path (if not available in system PATH)
# Windows example: C:\ffmpeg\bin\ffmpeg.exe
# Linux/Docker example: /usr/bin/ffmpeg
FFMPEG_PATH=

# [OPTIONAL] Path to YouTube cookies file for yt-dlp authentication
COOKIES_FILE=
